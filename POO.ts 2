// ATVD 4
abstract class Forma {
    abstract calcularArea(): number;
}

class Retangulo extends Forma {
    base: number;
    altura: number;

    constructor(base: number, altura: number) {
        super();
        this.base = base;
        this.altura = altura;
    }

    calcularArea(): number {
        return this.base * this.altura;
    }
}

class Circulo extends Forma {
    raio: number;

    constructor(raio: number) {
        super();
        this.raio = raio;
    }

    calcularArea(): number {
        return 3.14 * this.raio * this.raio;
    }
}

const caixa = new Retangulo(10, 5.5);
const pizza = new Circulo(30);

console.log("Area retangulo:", caixa.calcularArea());
console.log("Area circulo:", pizza.calcularArea());
// ATVD 5
abstract class Pessoa {
    public nome: string;
    private _idSecreto: number;

    constructor(nome: string, id: number) {
        this.nome = nome;
        this._idSecreto = id;
    }

    getId(): number {
        return this._idSecreto;
    }

    abstract baterPonto(): string;
}

class Aluno extends Pessoa {
    private _notaGeral: number = 0;

    constructor(nome: string, id: number) {
        super(nome, id);
    }

    setNota(valor: number) {
        if (valor >= 0 && valor <= 10) {
            this._notaGeral = valor;
        }
    }

    baterPonto(): string {
        return `O aluno ${this.nome} entrou correndo na sala porque tava atrasado.`;
    }
}

class Professor extends Pessoa {
    private _salarioMixaria: number;

    constructor(nome: string, id: number, salario: number) {
        super(nome, id);
        this._salarioMixaria = salario;
    }

    baterPonto(): string {
        return `O professor ${this.nome} assinou a folha de ponto com raiva.`;
    }
}

const cobaia1 = new Aluno("Cleiton Rasta Da Silva", 999);
cobaia1.setNota(4.2);

const cobaia2 = new Professor("Reginaldo Rossi Junior", 4242, 1200.50);

const listagem: Pessoa[] = [cobaia1, cobaia2];

listagem.forEach(p => {
    console.log("Nome do cidadao:", p.nome);
    console.log("Identificacao secreta:", p.getId());
    console.log(p.baterPonto());
});

